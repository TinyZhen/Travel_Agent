% Roameo colour theme for the Gemini beamerposter theme. Neutral: near-black type on white, the
% app's teal as the one brand colour. No institution colours, no logos, no decorative rules.

\definecolor{roameoteal}{HTML}{0F766E}
\definecolor{roameoink}{HTML}{1F1F1F}
\definecolor{roameomuted}{HTML}{5F6368}

\setbeamercolor{palette primary}{fg=roameoink,bg=white}
\setbeamercolor{palette secondary}{fg=roameoink,bg=white}
\setbeamercolor{palette tertiary}{fg=roameoink,bg=white}
\setbeamercolor{palette quaternary}{fg=roameoink,bg=white}
\setbeamercolor{structure}{fg=roameoteal}

% Headline: white, the title in teal, no rule under it
\setbeamercolor{headline}{fg=roameoink,bg=white}
\setbeamercolor{headline title}{fg=roameoteal}
\setbeamercolor*{headline rule}{}

% Blocks: no tinted boxes and no separator rules
\setbeamercolor{block title}{fg=roameoteal,bg=white}
\setbeamercolor{block separator}{bg=white}
\setbeamercolor{block body}{fg=roameoink,bg=white}
\setbeamercolor{block alerted title}{fg=roameoteal,bg=white}
\setbeamercolor{block alerted separator}{bg=white}
\setbeamercolor{block alerted body}{fg=roameoink,bg=white}
\setbeamercolor{block example title}{fg=roameoteal,bg=white}
\setbeamercolor{block example separator}{bg=white}
\setbeamercolor{block example body}{fg=roameoink,bg=white}

\setbeamercolor{heading}{fg=roameoteal}
\setbeamercolor{item}{fg=roameoteal}
\setbeamercolor{normal text}{fg=roameoink}
